// =============================================================================
// FROZEN-v1 SCHEMA (PH-D02) — discovery interviews (PH-D01) are still a human
// task, so every discovery-dependent decision is a DEFAULT marked NEEDS_HUMAN
// (see Docs/NEEDS_HUMAN.md "Schema-freeze defaults"). Designed from KX-06
// (Kiorly Pharmacy PRD) + KX-09 events. Change only via new named migrations. 2025 kiorex-backend entities were used as DESIGN NOTES only
// (Docs/DESIGN_NOTES_FROM_2025.md); no code copied (ADR-026).
//
// Conventions
//  - Every business table carries orgId (the Kiorly tenant) => tenant isolation
//    (a safety control, never a flag). Child tables inherit via parent FK and
//    are listed as unscoped in test/schema.pharmacy.cases.ts only when truly so.
//  - Money = Decimal(14,2) in the market currency (no hard-coded currency).
//  - Stock is changed ONLY by appending StockMovement rows (DB trigger forbids
//    UPDATE/DELETE on StockMovement). StockLot.qtyOnHand is a projection.
//  - Lot states: RECEIVED -> AVAILABLE -> RESERVED -> DISPENSED; QUARANTINE /
//    EXPIRED / RECALLED are blocked states (sale impossible outside
//    AVAILABLE/RESERVED). The DB CHECKs in migration enforce key invariants.
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------- enums ----

enum Edition {
  LITE
  PRO
  CHAIN
  ENTERPRISE
}

enum StaffRole {
  OWNER
  PHARMACIST
  CASHIER
  BRANCH_MANAGER
  CHAIN_OPS
  /// Pharmacy assistant: counter + stock work under pharmacist supervision; cannot sign off dispensing.
  ASSISTANT
}

enum ControlledSchedule {
  NONE
  SCHEDULE_1
  SCHEDULE_2
  SCHEDULE_3
  SCHEDULE_4
}

/// KPINV: sale is impossible outside AVAILABLE / RESERVED.
enum LotStatus {
  RECEIVED
  AVAILABLE
  RESERVED
  DISPENSED
  QUARANTINE
  EXPIRED
  RECALLED
}

enum StockMovementType {
  RECEIPT
  SALE
  DISPENSE
  RETURN_FROM_CUSTOMER
  RETURN_TO_SUPPLIER
  ADJUSTMENT
  EXPIRY_WRITE_OFF
  RECALL_WRITE_OFF
  TRANSFER_OUT
  TRANSFER_IN
  RESERVE
  RELEASE_RESERVATION
  COUNT_VARIANCE
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum RecallStatus {
  ACTIVE
  LIFTED
}

enum StockCountType {
  CYCLE
  FULL
}

enum StockCountStatus {
  OPEN
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum RxSource {
  PAPER_SCAN
  KIORLY_E_RX
  KIOREX_UPLOAD
  /// Walk-in / phone / handwritten Rx keyed in by staff without a scan (standalone-first).
  MANUAL_ENTRY
  /// Transferred in from another pharmacy.
  TRANSFER_IN
}

enum RxStatus {
  RECEIVED
  VALIDATING
  VALIDATED
  REJECTED
  PARTIALLY_DISPENSED
  DISPENSED
  CANCELLED
  EXPIRED
  /// Remaining quantity sent to another pharmacy (RxTransfer OUT).
  TRANSFERRED_OUT
}

enum DispensingStatus {
  DRAFT
  VALIDATED
  RESERVED
  SIGNED_OFF
  DISPENSED
  CANCELLED
}

enum SafetyCheckKind {
  INTERACTION
  ALLERGY
  DUPLICATE_THERAPY
  DOSE_QUANTITY
  PRESCRIBER
  CONTROLLED_LIMIT
  /// Prescribed daily dose vs the knowledge-base range (adult / paediatric).
  DOSE_RANGE
  /// Pregnancy category / lactation guidance from the knowledge base.
  PREGNANCY_LACTATION
  /// Renal / hepatic impairment flags on the customer vs the knowledge base.
  RENAL_HEPATIC
}

enum SafetyCheckOutcome {
  PASS
  WARN
  BLOCK
  OVERRIDDEN_BY_PHARMACIST
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum SaleStatus {
  OPEN
  COMPLETED
  VOIDED
  PARTIALLY_RETURNED
  RETURNED
}

enum SaleChannel {
  POS
  KIOREX_ORDER
}

enum PaymentMethod {
  CASH
  CARD
  INSTAPAY
  FAWRY
  WALLET
  CUSTOMER_CREDIT
  /// Redeemed loyalty points (value per point from tenant settings).
  LOYALTY_POINTS
  /// Kiorex order already paid on Kiorex Pay (settled by the kernel, not at the till).
  KIOREX_PREPAID
}

enum TransferStatus {
  REQUESTED
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum KiorexOrderStatus {
  RECEIVED
  ACCEPTED
  PARTIALLY_ACCEPTED
  REJECTED
  READY
  DISPENSED
  CANCELLED
  EXPIRED
}

enum SupplierLedgerType {
  INVOICE
  PAYMENT
  RETURN_CREDIT
  ADJUSTMENT
}

enum ClaimStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAID
}

enum NotificationChannel {
  WHATSAPP
  SMS
  EMAIL
  PUSH
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
}

// ------------------------------------------------------- tenancy / staff ----

model Tenant {
  id                 String    @id @default(cuid())
  /// Kiorly org id as issued by the Kiorex flag/identity plane.
  externalOrgId      String?   @unique
  name               String
  edition            Edition   @default(LITE)
  marketCode         String    @default("EG")
  /// Local stand-in for the kernel subscription (PH-F09 seam): ACTIVE | TRIAL | SUSPENDED.
  subscriptionStatus String    @default("ACTIVE")
  /// Market-pack overrides (VAT label/rate, currency, thresholds). See kernel-adapter/market-pack.
  settings           Json?
  onboardedAt        DateTime?
  createdAt          DateTime  @default(now())

  branches Branch[]
  staff    StaffUser[]
}

model Branch {
  id             String   @id @default(cuid())
  orgId          String
  name           String
  /// EDA / pharmacy licence number (KPRX05 / regulatory), market-specific.
  licenceNo      String?
  address        String?
  code           String?
  phone          String?
  active         Boolean  @default(true)
  /// Atomic counter for receipt numbers (KPPOS06).
  receiptCounter Int      @default(0)
  createdAt      DateTime @default(now())

  tenant Tenant @relation(fields: [orgId], references: [id])

  @@unique([orgId, code])
  @@index([orgId])
}

model StaffUser {
  id                  String    @id @default(cuid())
  orgId               String
  /// Kiorex Account subject (OIDC `sub`); identity stays out of clinical data (ADR-013).
  subject             String?
  displayName         String
  role                StaffRole
  /// Required for PHARMACIST: syndicate licence number.
  pharmacistLicenceNo String?
  active              Boolean   @default(true)
  /// Local-auth login (AUTH_MODE=local). In AUTH_MODE=oidc identity comes from Kiorex Passport and these stay null.
  email               String?   @unique
  passwordHash        String?
  branchId            String?
  mfaEnrolled         Boolean   @default(false)
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())

  tenant Tenant @relation(fields: [orgId], references: [id])

  @@unique([orgId, subject])
  @@index([orgId, role])
}

// ------------------------------------------------------------- catalogue ----

/// KPCAT01/02: drug master seeded from the Kiorly Egyptian drug database.
model Drug {
  id                  String             @id @default(cuid())
  /// null = global seed row; set = tenant-local addition.
  orgId               String?
  brandName           String
  brandNameAr         String?
  activeIngredient    String
  strength            String
  dosageForm          String
  packSize            String
  gtin                String?
  manufacturer        String?
  // regulatory flags (KPCAT02)
  rxOnly              Boolean            @default(false)
  controlledSchedule  ControlledSchedule @default(NONE)
  coldChain           Boolean            @default(false)
  otc                 Boolean            @default(false)
  /// Market-specific codes, e.g. {"EG":{"edaCode":"..."}}.
  marketCodes         Json?
  substitutionGroupId String?
  /// Per-drug VAT override (fraction, e.g. 0.14). null => market-pack default. Display/export only.
  vatRate             Decimal?           @db.Decimal(5, 4)
  /// Reporting category (margin by category), e.g. "Analgesics", "Antibiotics", "Vitamins".
  category            String?
  /// Name of the base stock unit (what StockLot.qtyOnHand counts): pack | strip | bottle ...
  baseUnit            String             @default("pack")
  /// Dataset key for idempotent seed/re-import (e.g. "egdb:12345").
  sourceKey           String?            @unique
  active              Boolean            @default(true)
  createdAt           DateTime           @default(now())

  substitutionGroup SubstitutionGroup? @relation(fields: [substitutionGroupId], references: [id])
  prices            PriceBookEntry[]
  uoms              UomConversion[]
  lots              StockLot[]
  rxLines           PrescriptionLine[]
  reorderPolicies   ReorderPolicy[]

  @@index([orgId, activeIngredient])
  @@index([gtin])
}

/// KPCAT04: generic substitution = same active ingredient + strength + form.
model SubstitutionGroup {
  id               String @id @default(cuid())
  activeIngredient String
  strength         String
  dosageForm       String

  drugs Drug[]

  @@unique([activeIngredient, strength, dosageForm])
}

/// KPCAT03: effective-dated prices; history retained (never updated in place).
model PriceBookEntry {
  id            String    @id @default(cuid())
  orgId         String
  drugId        String
  /// null = org-wide (chain central price book); set = branch override.
  branchId      String?
  price         Decimal   @db.Decimal(14, 2)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdBy     String?
  createdAt     DateTime  @default(now())

  drug Drug @relation(fields: [drugId], references: [id])

  @@index([orgId, drugId, effectiveFrom])
}

// ------------------------------------------------------------- suppliers ----

model Supplier {
  id           String   @id @default(cuid())
  orgId        String
  name         String
  phone        String?
  email        String?
  paymentTerms String?
  creditLimit  Decimal? @db.Decimal(14, 2)
  /// Running payable balance projection; ledger lives in the commerce kernel.
  balance      Decimal  @default(0) @db.Decimal(14, 2)
  leadTimeDays Int      @default(2)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  purchaseOrders PurchaseOrder[]
  lots           StockLot[]
  ledger         SupplierLedgerEntry[]

  @@index([orgId])
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  orgId      String
  branchId   String
  supplierId String
  status     PurchaseOrderStatus @default(DRAFT)
  /// Auto-reorder suggestion origin (KPSUP02): MANUAL | MIN_MAX | FORECAST.
  origin     String              @default("MANUAL")
  createdBy  String?
  poNumber   String?
  expectedAt DateTime?
  notes      String?
  /// WHATSAPP | EMAIL (KPSUP02 one-tap PO; mock adapters until go-live).
  sentVia    String?
  totalCost  Decimal             @default(0) @db.Decimal(14, 2)
  sentAt     DateTime?
  createdAt  DateTime            @default(now())

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  lines    PurchaseOrderLine[]
  lots     StockLot[]

  @@unique([orgId, poNumber])
  @@index([orgId, branchId, status])
}

model PurchaseOrderLine {
  id              String  @id @default(cuid())
  purchaseOrderId String
  drugId          String
  qtyOrdered      Int
  qtyReceived     Int     @default(0)
  unitCost        Decimal @db.Decimal(14, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
}

/// KPSUP03: recall notice blocks affected lots across branches within 5 minutes.
model RecallNotice {
  id           String       @id @default(cuid())
  orgId        String
  drugId       String
  /// Affected lot numbers (as printed on pack).
  lotNumbers   String[]
  affectedLots Int          @default(0)
  reason       String
  source       String? // EDA notice ref / supplier letter
  status       RecallStatus @default(ACTIVE)
  enteredBy    String
  enteredAt    DateTime     @default(now())
  liftedBy     String?
  liftedAt     DateTime?

  @@index([orgId, status])
}

// ------------------------------------------------------------- inventory ----

/// KPINV01/02: a received lot with expiry; FEFO = order by expiryDate asc.
model StockLot {
  id                String     @id @default(cuid())
  orgId             String
  branchId          String
  drugId            String
  lotNumber         String
  expiryDate        DateTime   @db.Date
  status            LotStatus  @default(RECEIVED)
  /// Projection of the movement ledger.
  qtyOnHand         Int        @default(0)
  qtyReserved       Int        @default(0)
  unitCost          Decimal    @db.Decimal(14, 2)
  supplierId        String?
  purchaseOrderId   String?
  supplierInvoiceNo String?
  receivedAt        DateTime   @default(now())
  /// Why the lot is blocked (QUARANTINE/RECALLED/EXPIRED), for audit and UI.
  blockedReason     String?
  blockedAt         DateTime?
  recallNoticeId    String?
  /// Status before the block, restored when a quarantine/recall is lifted.
  statusBeforeBlock LotStatus?
  /// Shelf / fridge / safe the lot sits in.
  locationId        String?
  createdAt         DateTime   @default(now())

  drug            Drug               @relation(fields: [drugId], references: [id])
  supplier        Supplier?          @relation(fields: [supplierId], references: [id])
  purchaseOrder   PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  movements       StockMovement[]
  dispensingLines DispensingLine[]
  saleLines       SaleLine[]
  readings        ColdChainReading[]
  expiryAlerts    ExpiryAlert[]

  @@unique([branchId, drugId, lotNumber])
  /// FEFO picking index.
  @@index([branchId, drugId, status, expiryDate])
}

/// Append-only stock ledger (DB trigger blocks UPDATE/DELETE). qtyDelta is signed.
model StockMovement {
  id                String            @id @default(cuid())
  orgId             String
  branchId          String
  lotId             String
  type              StockMovementType
  qtyDelta          Int
  reason            String?
  /// Source document: sale/dispensing/PO/count/recall id + kind.
  refType           String?
  refId             String?
  /// Adjustment reason code for reporting (DAMAGE | THEFT | LOSS | FOUND | COUNT_CORRECTION | SAMPLE | OTHER).
  reasonCode        String?
  /// Negative stock only with manager permission (KPINV03): who approved.
  managerApprovalBy String?
  performedBy       String
  occurredAt        DateTime          @default(now())

  lot StockLot @relation(fields: [lotId], references: [id])

  @@index([orgId, branchId, occurredAt])
  @@index([lotId, occurredAt])
  @@index([refType, refId])
}

/// KPINV06: cold-chain temperature log; excursion => lot QUARANTINE.
model ColdChainReading {
  id           String   @id @default(cuid())
  orgId        String
  lotId        String
  temperatureC Decimal  @db.Decimal(5, 2)
  excursion    Boolean  @default(false)
  recordedBy   String
  recordedAt   DateTime @default(now())

  lot StockLot @relation(fields: [lotId], references: [id])

  @@index([lotId, recordedAt])
}

/// KPINV05: cycle and full stock counts with variance approval.
model StockCount {
  id         String           @id @default(cuid())
  orgId      String
  branchId   String
  type       StockCountType
  status     StockCountStatus @default(OPEN)
  startedBy  String
  approvedBy String?
  startedAt  DateTime         @default(now())
  closedAt   DateTime?

  lines StockCountLine[]

  @@index([orgId, branchId, status])
}

model StockCountLine {
  id           String @id @default(cuid())
  stockCountId String
  lotId        String
  qtyExpected  Int
  /// null until counted.
  qtyCounted   Int?

  stockCount StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)

  @@index([stockCountId])
}

// ---------------------------------------------------------- prescriptions ---

/// Minimal patient reference. Pharmacy never stores a Kiorly clinical record; only what dispensing needs.
model PatientRef {
  id              String   @id @default(cuid())
  orgId           String
  /// Kiorex/Kiorly patient pseudonymous id when known (integrated mode only; standalone customers have none).
  externalId      String?
  /// Human-friendly customer number (CUS-000123), unique per tenant.
  customerNo      String?
  displayName     String
  phone           String?
  email           String?
  gender          String?
  dateOfBirth     DateTime? @db.Date
  address         String?
  /// Egyptian national ID captured for controlled dispensing (KPRX05): store hash + last4 only.
  nationalIdHash  String?
  nationalIdLast4 String?
  /// Active ingredients the patient is allergic to (KPRX03). Captured at the counter or from consented Rx context.
  allergies       String[]
  /// Chronic conditions (free text, lower-case keys like "diabetes", "hypertension").
  chronicConditions String[]
  medicalNotes    String?
  /// Clinical flags used by the safety engine (pregnancy / lactation / renal / hepatic).
  pregnant          Boolean  @default(false)
  lactating         Boolean  @default(false)
  renalImpairment   Boolean  @default(false)
  hepaticImpairment Boolean  @default(false)
  weightKg          Decimal? @db.Decimal(5, 1)
  birthYear       Int?
  /// Consent records (data processing is required to store the profile; marketing is opt-in).
  consentDataProcessing Boolean   @default(false)
  consentMarketing      Boolean   @default(false)
  consentRecordedAt     DateTime?
  consentRecordedBy     String?
  loyaltyPoints   Int      @default(0)
  loyaltyTier     String   @default("BRONZE")
  lifetimeSpend   Decimal  @default(0) @db.Decimal(14, 2)
  active          Boolean  @default(true)
  /// Set when this record was merged into another (kept for audit, hidden from search).
  mergedIntoId    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  prescriptions   Prescription[]
  customerAccount CustomerAccount?

  @@unique([orgId, customerNo])
  @@index([orgId, phone])
  @@index([orgId, externalId])
  @@index([orgId, displayName])
}

/// Free-text notes on a customer: general, counselling, complaint.
model CustomerNote {
  id        String   @id @default(cuid())
  orgId     String
  patientId String
  kind      String   @default("NOTE")
  body      String
  refType   String?
  refId     String?
  createdBy String
  createdAt DateTime @default(now())

  @@index([orgId, patientId, createdAt])
}

/// Family / household link between two customers (parent-child, spouse, carer ...). Stored once; read both ways.
model FamilyLink {
  id               String   @id @default(cuid())
  orgId            String
  patientId        String
  relatedPatientId String
  relation         String
  createdBy        String
  createdAt        DateTime @default(now())

  @@unique([patientId, relatedPatientId])
  @@index([orgId, patientId])
  @@index([orgId, relatedPatientId])
}

/// Loyalty points ledger (EARN +, REDEEM -, ADJUST +/-, MERGE +). PatientRef.loyaltyPoints is the projection.
model LoyaltyEntry {
  id           String   @id @default(cuid())
  orgId        String
  patientId    String
  kind         String
  points       Int
  balanceAfter Int
  saleId       String?
  note         String?
  createdBy    String?
  createdAt    DateTime @default(now())

  @@index([orgId, patientId, createdAt])
}

/// KPRX01: Rx intake from paper scan, Kiorly e-Rx (PrescriptionIssued v2 + consent token) or Kiorex upload.
model Prescription {
  id                      String    @id @default(cuid())
  orgId                   String
  branchId                String
  source                  RxSource
  status                  RxStatus  @default(RECEIVED)
  patientId               String?
  /// Event idempotency: PrescriptionIssued eventId (KX-09). Duplicate deliveries are no-ops.
  sourceEventId           String?
  /// Opaque ref of the prescription in the issuing system.
  sourceRxRef             String?
  /// SHA-256 of the patient consent token presented with the e-Rx (never the raw token).
  consentTokenHash        String?
  consentVerifiedAt       DateTime?
  consentExpiresAt        DateTime?
  /// KPRX02: prescriber identity + whether a Kiorly-verified doctor badge was present.
  prescriberName          String?
  prescriberLicenceNo     String?
  prescriberVerifiedBadge Boolean   @default(false)
  issuedAt                DateTime?
  validUntil              DateTime?
  scanStorageKey          String?
  prescriberRef           String?
  /// Prescriber directory entry (standalone: the doctors this pharmacy knows).
  prescriberId            String?
  /// Repeat / refill tracking: refills authorised on top of the first fill.
  refillsAllowed          Int       @default(0)
  refillsUsed             Int       @default(0)
  refillIntervalDays      Int?
  nextRefillDueAt         DateTime?
  priority                String    @default("NORMAL")
  verificationNotes       String?
  transferredOutAt        DateTime?
  clinicRef               String?
  validatedBy             String?
  validatedAt             DateTime?
  kiorexOrderId           String?
  rejectionReason         String?
  receivedBy              String?
  receivedAt              DateTime  @default(now())

  patient     PatientRef?        @relation(fields: [patientId], references: [id])
  lines       PrescriptionLine[]
  dispensings Dispensing[]

  /// One intake per issuing event per tenant.
  @@unique([orgId, sourceEventId])
  @@index([orgId, branchId, status])
  @@index([orgId, prescriberId])
  @@index([orgId, patientId])
  @@index([orgId, nextRefillDueAt])
}

model PrescriptionLine {
  id               String  @id @default(cuid())
  prescriptionId   String
  /// Prescribed (not necessarily dispensed) product; null when only an ingredient was written.
  drugId           String?
  activeIngredient String?
  strength         String?
  dosageForm       String?
  quantity         Int
  qtyDispensed     Int     @default(0)
  drugName         String?
  controlled       Boolean @default(false)
  /// Free-text sig as written (dose, frequency, duration).
  directions       String?

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  drug         Drug?        @relation(fields: [drugId], references: [id])

  @@index([prescriptionId])
}

// ------------------------------------------------------------- dispensing ---

/// KPRX06: pharmacist sign-off (user + timestamp) is mandatory on every Rx dispense.
/// DB CHECK: status SIGNED_OFF/DISPENSED requires pharmacistId + signedOffAt (migration).
model Dispensing {
  id                   String           @id @default(cuid())
  orgId                String
  branchId             String
  prescriptionId       String?
  /// Set for OTC counter dispensing without an Rx (still recorded).
  patientId            String?
  status               DispensingStatus @default(DRAFT)
  pharmacistId         String?
  signedOffAt          DateTime?
  counsellingNotes     String?
  /// KPMKT: origin when it fulfils a Kiorex order.
  kiorexOrderRef       String?
  /// Controlled substances: ID captured (KPRX05).
  controlledIdCaptured Boolean          @default(false)
  /// Why less than the prescribed quantity was dispensed (partial fill).
  partialReason        String?
  counsellingTopics    String[]
  /// Set when the KPRX03 safety checks ran; DB CHECK requires it before sign-off.
  safetyChecksRunAt    DateTime?
  saleId               String?
  createdBy            String
  createdAt            DateTime         @default(now())
  dispensedAt          DateTime?

  prescription  Prescription?                 @relation(fields: [prescriptionId], references: [id])
  lines         DispensingLine[]
  safetyChecks  SafetyCheckResult[]
  controlledLog ControlledSubstanceLogEntry[]

  @@index([orgId, branchId, status])
  @@index([prescriptionId])
}

model DispensingLine {
  id                    String  @id @default(cuid())
  dispensingId          String
  drugId                String
  /// FEFO-reserved lot (KPINV02).
  lotId                 String
  quantity              Int
  /// KPRX04: substitution needs pharmacist decision + patient consent, both recorded.
  prescriptionLineId String?
  substitutedFromDrugId String?
  substitutionConsent   Boolean @default(false)
  substitutionDecidedBy String?
  unitPrice             Decimal @default(0) @db.Decimal(14, 2)
  vatRate               Decimal @default(0) @db.Decimal(5, 4)

  dispensing Dispensing @relation(fields: [dispensingId], references: [id], onDelete: Cascade)
  lot        StockLot   @relation(fields: [lotId], references: [id])

  @@index([dispensingId])
  @@index([lotId])
}

/// KPRX03: interaction / allergy / duplicate checks by active ingredient (shared engine with Clinic CL02).
model SafetyCheckResult {
  id             String             @id @default(cuid())
  dispensingId   String
  kind           SafetyCheckKind
  outcome        SafetyCheckOutcome
  detail         String?
  /// false = regulatory / contraindication hard stop that no pharmacist override can clear.
  overridable    Boolean            @default(true)
  /// Pharmacist override must be explicit and attributed.
  overriddenBy   String?
  overrideReason String?
  checkedAt      DateTime           @default(now())

  dispensing Dispensing @relation(fields: [dispensingId], references: [id], onDelete: Cascade)

  @@index([dispensingId])
}

/// KPRX05: controlled-medicine dispensing log per EDA rules. Append-only by convention + audit.
model ControlledSubstanceLogEntry {
  id                     String   @id @default(cuid())
  orgId                  String
  branchId               String
  dispensingId           String
  drugId                 String
  lotId                  String
  quantity               Int
  patientNationalIdLast4 String
  patientNationalIdHash  String?
  patientName            String?
  prescriptionId         String?
  prescriberLicenceNo    String?
  pharmacistId           String
  loggedAt               DateTime @default(now())

  dispensing Dispensing @relation(fields: [dispensingId], references: [id])

  @@index([orgId, branchId, loggedAt])
}

// ------------------------------------------------------------------- POS ----

model Shift {
  id              String      @id @default(cuid())
  orgId           String
  branchId        String
  openedBy        String
  closedBy        String?
  status          ShiftStatus @default(OPEN)
  openingFloat    Decimal     @db.Decimal(14, 2)
  countedCash     Decimal?    @db.Decimal(14, 2)
  expectedCash    Decimal?    @db.Decimal(14, 2)
  /// KPPOS04: variance above threshold alerts the owner via WhatsApp (template TODO_NEEDS_HUMAN).
  variance        Decimal?    @db.Decimal(14, 2)
  varianceAlerted Boolean     @default(false)
  zReport         Json?
  openedAt        DateTime    @default(now())
  closedAt        DateTime?

  sales Sale[]

  @@index([orgId, branchId, status])
}

model Sale {
  id                String      @id @default(cuid())
  orgId             String
  branchId          String
  shiftId           String?
  channel           SaleChannel @default(POS)
  status            SaleStatus  @default(OPEN)
  /// Offline POS (KPPOS01): client-generated key makes queued sync idempotent.
  idempotencyKey    String
  receiptNo         String?
  customerAccountId String?
  /// Customer registry link (works without a credit account); loyalty points accrue here.
  patientId         String?
  /// Set when this sale is the replacement side of an exchange.
  exchangeOfSaleId  String?
  /// Dispensing that this Rx sale settles (links money to the sign-off).
  dispensingId      String?
  subtotal          Decimal     @default(0) @db.Decimal(14, 2)
  discountTotal     Decimal     @default(0) @db.Decimal(14, 2)
  /// VAT line for printed receipts / exports only (no tax-authority reporting).
  vatTotal          Decimal     @default(0) @db.Decimal(14, 2)
  total             Decimal     @default(0) @db.Decimal(14, 2)
  offline           Boolean     @default(false)
  clientCreatedAt   DateTime?
  voidedBy          String?
  voidReason        String?
  voidedAt          DateTime?
  soldBy            String
  soldAt            DateTime    @default(now())

  shift           Shift?           @relation(fields: [shiftId], references: [id])
  customerAccount CustomerAccount? @relation(fields: [customerAccountId], references: [id])
  lines           SaleLine[]
  payments        SalePayment[]
  returns         SaleReturn[]

  @@unique([orgId, idempotencyKey])
  @@index([orgId, branchId, soldAt])
  @@index([orgId, patientId])
}

model SaleLine {
  id        String  @id @default(cuid())
  saleId    String
  drugId    String
  lotId     String
  quantity  Int
  unitPrice Decimal @db.Decimal(14, 2)
  discount  Decimal @default(0) @db.Decimal(14, 2)
  vatRate   Decimal @default(0) @db.Decimal(5, 4)
  vatAmount Decimal @default(0) @db.Decimal(14, 2)

  sale Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  lot  StockLot @relation(fields: [lotId], references: [id])

  @@index([saleId])
  @@index([lotId])
}

/// KPPOS02: split tender => many payments per sale.
model SalePayment {
  id        String        @id @default(cuid())
  saleId    String
  method    PaymentMethod
  amount    Decimal       @db.Decimal(14, 2)
  /// PSP / wallet reference (InstaPay, Fawry). Sandbox-fake locally.
  reference String?
  status    String        @default("CAPTURED")
  paidAt    DateTime      @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

/// KPPOS03: returns/voids need reason + manager approval; restock to the correct lot.
model SaleReturn {
  id           String        @id @default(cuid())
  saleId       String
  saleLineId   String?
  refundMethod PaymentMethod @default(CASH)
  lotId        String
  quantity     Int
  refund       Decimal       @db.Decimal(14, 2)
  reason       String
  approvedBy   String
  createdAt    DateTime      @default(now())

  sale Sale @relation(fields: [saleId], references: [id])

  @@index([saleId])
}

/// KPPOS05: neighbourhood credit accounts with limits.
model CustomerAccount {
  id          String   @id @default(cuid())
  orgId       String
  patientId   String   @unique
  creditLimit Decimal  @default(0) @db.Decimal(14, 2)
  balance     Decimal  @default(0) @db.Decimal(14, 2)
  createdAt   DateTime @default(now())

  patient PatientRef            @relation(fields: [patientId], references: [id])
  sales   Sale[]
  entries CustomerCreditEntry[]

  @@index([orgId])
}

/// KPPOS05: credit ledger (CHARGE positive, PAYMENT negative); CustomerAccount.balance is the projection.
model CustomerCreditEntry {
  id        String   @id @default(cuid())
  orgId     String
  accountId String
  kind      String
  amount    Decimal  @db.Decimal(14, 2)
  saleId    String?
  note      String?
  createdBy String
  createdAt DateTime @default(now())

  account CustomerAccount @relation(fields: [accountId], references: [id])

  @@index([orgId, accountId, createdAt])
}

// ------------------------------------------------------ platform plumbing ---

/// Transactional outbox (ADR-006): DispenseCompleted / OrderReady / OrderRejected (pharmacist sign-off present).
model OutboxEvent {
  id            String       @id @default(cuid())
  orgId         String
  type          String
  aggregateType String
  aggregateId   String
  payload       Json
  target        String       @default("KIOREX")
  /// Idempotent enqueue: same (orgId, dedupeKey) is a no-op.
  dedupeKey     String?
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?
  nextAttemptAt DateTime?
  occurredAt    DateTime     @default(now())
  sentAt        DateTime?

  @@unique([orgId, dedupeKey])
  @@index([status, occurredAt])
  @@index([orgId])
}

/// Every state change affecting stock, money, access is audited (safety control).
model AuditLog {
  id         String   @id @default(cuid())
  orgId      String
  actorId    String?
  action     String
  entityType String
  entityId   String
  /// No PHI here: ids and field names only.
  meta       Json?
  at         DateTime @default(now())

  @@index([orgId, at])
  @@index([entityType, entityId])
}

/// Last good Kiorex flag snapshot (survives restarts; evaluation stays local).
model FlagSnapshotCache {
  product   String   @id
  version   String
  etag      String?
  body      Json
  fetchedAt DateTime @default(now())
}

// ======================================================= FROZEN-v1 additions ==

/// KPSUP02: min/max reorder policy per branch + drug (forecast may raise suggestions, never lower safety stock).
model ReorderPolicy {
  id           String   @id @default(cuid())
  orgId        String
  branchId     String
  drugId       String
  minQty       Int
  maxQty       Int
  leadTimeDays Int      @default(2)
  supplierId   String?
  updatedAt    DateTime @default(now())

  drug Drug @relation(fields: [drugId], references: [id])

  @@unique([branchId, drugId])
  @@index([orgId, branchId])
}

/// KPSUP01: supplier payable ledger (INVOICE +, PAYMENT -, RETURN_CREDIT -); Supplier.balance is the projection.
model SupplierLedgerEntry {
  id             String             @id @default(cuid())
  orgId          String
  supplierId     String
  type           SupplierLedgerType
  amount         Decimal            @db.Decimal(14, 2)
  refType        String?
  refId          String?
  note           String?
  idempotencyKey String?
  createdBy      String
  createdAt      DateTime           @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@unique([orgId, idempotencyKey])
  @@index([orgId, supplierId, createdAt])
}

/// KPINV01: goods receipt header (by PO or direct).
model GoodsReceipt {
  id              String   @id @default(cuid())
  orgId           String
  branchId        String
  supplierId      String?
  purchaseOrderId String?
  invoiceNo       String?
  invoiceTotal    Decimal? @db.Decimal(14, 2)
  idempotencyKey  String?
  receivedBy      String
  receivedAt      DateTime @default(now())

  lines GoodsReceiptLine[]

  @@unique([orgId, idempotencyKey])
  @@index([orgId, branchId, receivedAt])
}

model GoodsReceiptLine {
  id        String  @id @default(cuid())
  receiptId String
  drugId    String
  lotId     String
  quantity  Int
  unitCost  Decimal @db.Decimal(14, 2)
  /// Cost price variance: the PO line cost and the previous receipt cost per base unit at receipt time.
  poUnitCost   Decimal? @db.Decimal(14, 2)
  prevUnitCost Decimal? @db.Decimal(14, 2)

  receipt GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
}

/// KPINV04: return near-expiry / blocked stock to the supplier (RETURN_TO_SUPPLIER movement + supplier credit).
model SupplierReturn {
  id           String   @id @default(cuid())
  orgId        String
  branchId     String
  supplierId   String
  lotId        String
  quantity     Int
  creditAmount Decimal  @db.Decimal(14, 2)
  reason       String
  createdBy    String
  createdAt    DateTime @default(now())

  @@index([orgId, supplierId])
}

/// KPINV04: one alert per lot per threshold (90/60/30 days).
model ExpiryAlert {
  id            String   @id @default(cuid())
  orgId         String
  lotId         String
  thresholdDays Int
  notifiedAt    DateTime @default(now())

  lot StockLot @relation(fields: [lotId], references: [id])

  @@unique([lotId, thresholdDays])
  @@index([orgId])
}

/// Chain edition inter-branch transfer (draft schema open question 4: in-transit state).
model StockTransfer {
  id           String         @id @default(cuid())
  orgId        String
  fromBranchId String
  toBranchId   String
  status       TransferStatus @default(REQUESTED)
  requestedBy  String
  dispatchedBy String?
  receivedBy   String?
  createdAt    DateTime       @default(now())
  dispatchedAt DateTime?
  receivedAt   DateTime?

  lines StockTransferLine[]

  @@index([orgId, status])
}

model StockTransferLine {
  id         String @id @default(cuid())
  transferId String
  drugId     String
  lotId      String
  quantity   Int

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
}

/// KPMKT01: opt-in per branch.
model BranchMarketplaceSetting {
  id               String   @id @default(cuid())
  orgId            String
  branchId         String   @unique
  optedIn          Boolean  @default(false)
  deliveryRadiusKm Decimal  @default(5) @db.Decimal(5, 2)
  /// {"mon":["09:00","23:00"],...}
  openingHours     Json?
  prepMinutes      Int      @default(30)
  slaMinutes       Int      @default(10)
  latitude         Decimal? @db.Decimal(9, 6)
  longitude        Decimal? @db.Decimal(9, 6)
  updatedAt        DateTime @default(now())

  @@index([orgId])
}

/// KPMKT02: order received from Kiorex (HMAC REST). Controlled medicines are rejected at ingest (KPRX05).
model KiorexOrder {
  id              String            @id @default(cuid())
  orgId           String
  branchId        String
  /// Kiorex order id. Idempotent ingest key.
  externalOrderId String
  status          KiorexOrderStatus @default(RECEIVED)
  hasRx           Boolean           @default(false)
  prescriptionId  String?
  customerName    String?
  customerPhone   String?
  deliveryAddress String?
  prepaid         Boolean           @default(true)
  orderValue      Decimal           @default(0) @db.Decimal(14, 2)
  slaDueAt        DateTime
  respondedAt     DateTime?
  respondedBy     String?
  rejectionReason String?
  rejectionCode   String?
  readyAt         DateTime?
  dispensingId    String?
  /// Kiorex patient subject (opaque ref; also the Rx patient externalId). Never shown outside the order.
  patientRef      String?
  /// PICKUP | DELIVERY as chosen in Kiorex.
  deliveryMethod  String?
  /// Kiorex Pay payment reference (reconciliation only).
  paymentRef      String?
  createdAt       DateTime          @default(now())

  lines KiorexOrderLine[]

  @@unique([orgId, externalOrderId])
  @@index([orgId, branchId, status])
}

model KiorexOrderLine {
  id           String  @id @default(cuid())
  orderId      String
  drugId       String
  qtyRequested Int
  qtyAccepted  Int     @default(0)
  unitPrice    Decimal @db.Decimal(14, 2)

  order KiorexOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

/// Kiorex machine-API credentials of ONE tenant (INTEGRATION.md "Vertical partners"): the client key binds the request to the
/// tenant, so there is no org header. Secrets are AES-GCM sealed (KEK from the secrets adapter in production).
model IntegrationClient {
  id               String   @id @default(cuid())
  orgId            String
  key              String   @unique
  secretEnc        String
  /// KIOREX (only source today).
  source           String   @default("KIOREX")
  /// Kiorex API base for outbox events and Rx token verification, e.g. http://localhost:4000 (paths are fixed by the contract).
  kiorexBaseUrl    String?
  webhookSecretEnc String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@index([orgId])
}

/// Inbound webhook de-duplication (Kiorex dedups on eventId; so do we).
model InboundEvent {
  id         String   @id @default(cuid())
  eventId    String
  type       String
  orgId      String
  receivedAt DateTime @default(now())

  @@unique([orgId, eventId])
}

/// Mock/dev inbox for every outbound message (CLAUDE.md: providers are MOCKED). Real adapters write delivery state here too.
model Notification {
  id        String              @id @default(cuid())
  orgId     String
  channel   NotificationChannel
  recipient String
  template  String
  locale    String              @default("en")
  body      String
  status    NotificationStatus  @default(QUEUED)
  refType   String?
  refId     String?
  provider  String              @default("mock")
  createdAt DateTime            @default(now())
  sentAt    DateTime?

  @@index([orgId, createdAt])
}

/// pharmacy.insurer_claims: basic claim data model (cash/self-pay is the default; no tax reporting).
model InsurerClaim {
  id            String      @id @default(cuid())
  orgId         String
  branchId      String
  saleId        String?
  insurerName   String
  memberRef     String
  policyNo      String?
  amountClaimed Decimal     @db.Decimal(14, 2)
  patientCopay  Decimal     @default(0) @db.Decimal(14, 2)
  /// Insurer's approved amount (may be lower than claimed), what has actually been paid, and the rejection reason.
  approvedAmount  Decimal?  @db.Decimal(14, 2)
  paidAmount      Decimal   @default(0) @db.Decimal(14, 2)
  rejectionReason String?
  /// Batch / submission reference given to the insurer.
  submissionRef   String?
  dueAt           DateTime?
  status        ClaimStatus @default(DRAFT)
  submittedAt   DateTime?
  resolvedAt    DateTime?
  responseNote  String?
  createdBy     String
  createdAt     DateTime    @default(now())

  @@index([orgId, status])
}

/// Offline POS reconciliation conflicts (PH-SS03): a queued sale that could not be applied as-is.
model SyncConflict {
  id             String   @id @default(cuid())
  orgId          String
  branchId       String
  idempotencyKey String
  reason         String
  payload        Json
  resolved       Boolean  @default(false)
  resolvedBy     String?
  createdAt      DateTime @default(now())

  @@unique([orgId, idempotencyKey])
  @@index([orgId, resolved])
}

/// Local kernel seam: credit wallet (PH-F09). Positive = credit.
model WalletEntry {
  id             String   @id @default(cuid())
  orgId          String
  amount         Decimal  @db.Decimal(14, 2)
  kind           String
  refType        String?
  refId          String?
  idempotencyKey String
  createdAt      DateTime @default(now())

  @@unique([orgId, idempotencyKey])
  @@index([orgId, createdAt])
}

/// Local kernel seam: per-fulfilled-order settlement fee (higher-of rule is computed by the kernel at invoice time).
model SettlementEntry {
  id         String   @id @default(cuid())
  orgId      String
  orderRef   String
  orderValue Decimal  @db.Decimal(14, 2)
  feeRate    Decimal  @db.Decimal(6, 4)
  feeAmount  Decimal  @db.Decimal(14, 2)
  currency   String   @default("EGP")
  createdAt  DateTime @default(now())

  @@unique([orgId, orderRef])
  @@index([orgId, createdAt])
}

// ======================================================= Standalone suite additions ==

/// Per-tenant permission matrix overrides on top of the built-in role defaults (Settings > Roles).
/// Safety-critical permissions (see auth/permissions.ts LOCKED_PERMISSIONS) and the OWNER role are never overridable.
model RolePermissionOverride {
  id         String    @id @default(cuid())
  orgId      String
  role       StaffRole
  permission String
  granted    Boolean
  updatedBy  String?
  updatedAt  DateTime  @default(now()) @updatedAt

  @@unique([orgId, role, permission])
  @@index([orgId])
}

/// Prescriber (doctor) directory: licence-checked, reusable on manual Rx entry, with verification state.
model Prescriber {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  nameAr      String?
  licenceNo   String
  specialty   String?
  phone       String?
  clinicName  String?
  clinicAddress String?
  /// Licence verified by a pharmacist (syndicate lookup done by a human).
  verified    Boolean  @default(false)
  verifiedBy  String?
  verifiedAt  DateTime?
  active      Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([orgId, licenceNo])
  @@index([orgId, name])
}

/// One row per refill granted on a repeat prescription.
model RxRefill {
  id             String   @id @default(cuid())
  orgId          String
  prescriptionId String
  refillNo       Int
  early          Boolean  @default(false)
  earlyReason    String?
  createdBy      String
  createdAt      DateTime @default(now())

  @@unique([prescriptionId, refillNo])
  @@index([orgId, prescriptionId])
}

/// Refill reminder sent (mock dev inbox until a real messaging provider is wired): one per Rx per refill number.
model RefillReminder {
  id             String   @id @default(cuid())
  orgId          String
  prescriptionId String
  refillNo       Int
  notificationId String?
  sentAt         DateTime @default(now())

  @@unique([prescriptionId, refillNo])
  @@index([orgId])
}

/// Prescription transfer between pharmacies. OUT: remaining quantities leave this pharmacy; IN: a transferred Rx is received.
model RxTransfer {
  id                   String   @id @default(cuid())
  orgId                String
  branchId             String
  direction            String
  prescriptionId       String
  counterpartyName     String
  counterpartyPhone    String?
  counterpartyPharmacist String?
  counterpartyLicenceNo  String?
  reason               String?
  /// Snapshot of the remaining lines at transfer time.
  snapshot             Json?
  createdBy            String
  createdAt            DateTime @default(now())

  @@index([orgId, direction, createdAt])
  @@index([prescriptionId])
}

/// Clinical knowledge base rows (seeded globally with orgId null; a tenant may add or override rules for itself).
/// kind: INTERACTION | DOSE_RANGE | PREGNANCY | LACTATION | RENAL | HEPATIC. SYNTHETIC starter data: a clinical pharmacist must review before pilot (NEEDS_HUMAN NH-PH-009).
model ClinicalRule {
  id                  String   @id @default(cuid())
  orgId               String?
  /// Natural key, e.g. "interaction:warfarin|aspirin" or "dose:paracetamol" (+ ":org:<id>" for tenant rules) — makes seeding idempotent.
  key                 String   @unique
  kind                String
  ingredient          String
  ingredientB         String?
  /// MINOR | MODERATE | MAJOR | CONTRAINDICATED
  severity            String   @default("MODERATE")
  note                String
  maxDailyMg          Decimal? @db.Decimal(10, 2)
  maxSingleMg         Decimal? @db.Decimal(10, 2)
  pediatricMaxMgPerKg Decimal? @db.Decimal(8, 2)
  /// Pregnancy category A | B | C | D | X.
  category            String?
  source              String   @default("seed")
  active              Boolean  @default(true)
  createdBy           String?
  createdAt           DateTime @default(now())

  @@index([kind, ingredient])
  @@index([orgId])
}

/// The controlled-substance register book: every stock-changing movement of a controlled medicine with the running balance
/// after it (per branch + drug), the people involved and the witness. Written by the stock ledger itself, never by hand.
model ControlledRegisterEntry {
  id                  String   @id @default(cuid())
  orgId               String
  branchId            String
  drugId              String
  lotId               String
  movementId          String   @unique
  /// StockMovementType as text.
  kind                String
  qtyDelta            Int
  balanceAfter        Int
  refType             String?
  refId               String?
  patientName         String?
  patientIdLast4      String?
  prescriptionId      String?
  prescriberLicenceNo String?
  performedBy         String
  witnessId           String?
  witnessName         String?
  reason              String?
  occurredAt          DateTime @default(now())

  @@index([orgId, branchId, drugId, occurredAt])
  @@index([orgId, occurredAt])
}

/// A difference between the physical count of a controlled medicine and the register balance.
model ControlledDiscrepancy {
  id          String    @id @default(cuid())
  orgId       String
  branchId    String
  drugId      String
  expectedQty Int
  countedQty  Int
  difference  Int
  /// OPEN | RESOLVED
  status      String    @default("OPEN")
  notes       String?
  reportedBy  String
  witnessId   String?
  resolvedBy  String?
  resolution  String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([orgId, status])
}

// ------------------------------------------------------------------- POS suite ----

/// Promotions, coupons and bundle deals. kind: PERCENT_OFF {percent} | AMOUNT_OFF {amount per unit} | BUY_X_GET_Y {buy,get,percentOff?} | BUNDLE_PRICE {items:[{drugId,qty}],price}.
/// drugIds scope the promotion (empty = whole cart for PERCENT_OFF). A couponCode makes it redeemable only with that code.
model Promotion {
  id               String    @id @default(cuid())
  orgId            String
  /// null = all branches.
  branchId         String?
  name             String
  nameAr           String?
  kind             String
  couponCode       String?
  drugIds          String[]
  params           Json
  startsAt         DateTime  @default(now())
  endsAt           DateTime?
  minSubtotal      Decimal?  @db.Decimal(14, 2)
  maxUses          Int?
  usedCount        Int       @default(0)
  priority         Int       @default(0)
  /// false = a drug already discounted by a higher-priority promotion is skipped.
  stackable        Boolean   @default(false)
  active           Boolean   @default(true)
  createdBy        String?
  createdAt        DateTime  @default(now())

  @@unique([orgId, couponCode])
  @@index([orgId, active, startsAt])
}

model PromotionRedemption {
  id             String   @id @default(cuid())
  orgId          String
  promotionId    String
  saleId         String
  patientId      String?
  discountAmount Decimal  @db.Decimal(14, 2)
  couponCode     String?
  createdAt      DateTime @default(now())

  @@index([orgId, promotionId])
  @@index([saleId])
}

/// A parked cart at the till (customer stepped away / fetching the Rx): resumed later by any till user of the branch.
model HeldCart {
  id        String    @id @default(cuid())
  orgId     String
  branchId  String
  userId    String
  label     String
  patientId String?
  payload   Json
  /// HELD | RESUMED | DISCARDED
  status    String    @default("HELD")
  createdAt DateTime  @default(now())
  resolvedAt DateTime?

  @@index([orgId, branchId, status])
}

/// Cash drawer movements inside a shift (petty cash, bank deposit, float top-up, supplier cash, expense paid from the till).
model CashMovement {
  id        String   @id @default(cuid())
  orgId     String
  branchId  String
  shiftId   String
  /// IN | OUT
  kind      String
  category  String
  amount    Decimal  @db.Decimal(14, 2)
  reason    String
  refType   String?
  refId     String?
  createdBy String
  createdAt DateTime @default(now())

  @@index([orgId, shiftId])
  @@index([orgId, branchId, createdAt])
}

// ------------------------------------------------------------- inventory suite ----

/// Physical storage places per branch (shelf A3, fridge 1, controlled safe ...). Lots point at a location.
model ShelfLocation {
  id        String   @id @default(cuid())
  orgId     String
  branchId  String
  code      String
  label     String?
  /// SHELF | FRIDGE | SAFE | BACKROOM | DISPLAY | QUARANTINE
  kind      String   @default("SHELF")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([branchId, code])
  @@index([orgId, branchId])
}

/// Pack conversion: 1 `name` (box, carton, strip ...) = `factor` base units of the drug. Used when receiving and selling in another unit.
model UomConversion {
  id        String   @id @default(cuid())
  orgId     String
  drugId    String
  name      String
  factor    Int
  barcode   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  drug Drug @relation(fields: [drugId], references: [id])

  @@unique([orgId, drugId, name])
  @@index([orgId, drugId])
}

// ------------------------------------------------------ purchasing & finance suite ----

/// Request for quotation: ask several suppliers to price the same lines, compare, award (creates POs).
model RequestForQuote {
  id             String    @id @default(cuid())
  orgId          String
  branchId       String
  number         String
  /// DRAFT | SENT | QUOTED | AWARDED | CLOSED | CANCELLED
  status         String    @default("DRAFT")
  notes          String?
  dueAt          DateTime?
  createdBy      String
  createdAt      DateTime  @default(now())
  awardedAt      DateTime?

  lines  RfqLine[]
  quotes RfqQuote[]

  @@unique([orgId, number])
  @@index([orgId, status])
}

model RfqLine {
  id     String @id @default(cuid())
  rfqId  String
  drugId String
  qty    Int

  rfq RequestForQuote @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@index([rfqId])
}

model RfqQuote {
  id           String    @id @default(cuid())
  rfqId        String
  supplierId   String
  /// INVITED | QUOTED | DECLINED | AWARDED
  status       String    @default("INVITED")
  leadTimeDays Int?
  validUntil   DateTime?
  notes        String?
  receivedAt   DateTime?
  createdAt    DateTime  @default(now())

  rfq   RequestForQuote @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  lines RfqQuoteLine[]

  @@unique([rfqId, supplierId])
  @@index([rfqId])
}

model RfqQuoteLine {
  id        String  @id @default(cuid())
  quoteId   String
  rfqLineId String
  unitPrice Decimal @db.Decimal(14, 2)

  quote RfqQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId, rfqLineId])
}

/// Operating expense (rent, utilities, salaries ...). Paid from the cash drawer => also a CashMovement OUT.
model Expense {
  id             String    @id @default(cuid())
  orgId          String
  branchId       String
  category       String
  amount         Decimal   @db.Decimal(14, 2)
  /// VAT included in the amount (informational, for the accountant export only).
  vatAmount      Decimal   @default(0) @db.Decimal(14, 2)
  /// CASH | CARD | BANK | OTHER
  method         String    @default("CASH")
  description    String
  supplierId     String?
  expenseDate    DateTime  @db.Date
  receiptRef     String?
  fromDrawer     Boolean   @default(false)
  cashMovementId String?
  createdBy      String
  voidedAt       DateTime?
  voidedBy       String?
  createdAt      DateTime  @default(now())

  @@index([orgId, branchId, expenseDate])
  @@index([orgId, category])
}

/// A payment received from an insurer against a claim (partial payments allowed).
model ClaimPayment {
  id        String   @id @default(cuid())
  orgId     String
  claimId   String
  amount    Decimal  @db.Decimal(14, 2)
  reference String?
  paidAt    DateTime @default(now())
  createdBy String

  @@index([orgId, claimId])
}

// ------------------------------------------------------------- notification centre ----

/// In-app notification (alert): low stock, near expiry, refills due, discrepancies, overdue claims ... Generated by the scan job; read state is per user.
model Alert {
  id        String    @id @default(cuid())
  orgId     String
  branchId  String?
  /// LOW_STOCK | NEAR_EXPIRY | EXPIRED_STOCK | REFILLS_DUE | RX_WAITING | CONTROLLED_DISCREPANCY | CLAIMS_OVERDUE | SYNC_CONFLICTS | COLD_CHAIN | PO_OVERDUE | SHIFT_OPEN | RECALL_ACTIVE | CREDIT_LIMIT
  kind      String
  /// INFO | WARN | CRITICAL
  severity  String    @default("WARN")
  title     String
  body      String?
  /// Route in the web app the alert points to (e.g. /inventory).
  link      String?
  refType   String?
  refId     String?
  /// One alert per (orgId, dedupeKey): aggregates use the day, entity alerts use the entity id.
  dedupeKey String
  readBy    String[]
  createdAt DateTime  @default(now())
  resolvedAt DateTime?

  @@unique([orgId, dedupeKey])
  @@index([orgId, resolvedAt, createdAt])
}
