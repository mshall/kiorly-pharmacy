# Copy to apps/api/.env (gitignored). No secrets here.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/kiorly_pharmacy?schema=public"
# Pool size (Prisma 7 + pg adapter): `connection_limit=N` in the URL caps the pool; without it the pool uses DB_POOL_MAX, else 10 (explicit default).
# The shared local cluster has max_connections=100: seeds/tests use connection_limit=2..3; long-running APIs keep the default 10.
PORT=3100
LISTEN_HOST=127.0.0.1
SWAGGER_ENABLED=true

# Kiorex feature-flag control plane (INTEGRATION.md). Polling is OFF unless enabled.
# Product key format is ff_<product>_dev with the REGISTRY product name `kiorly-pharmacy` (hyphen).
FLAGS_POLL_ENABLED=false
KIOREX_FLAGS_URL=http://localhost:4000/api/v1/control/v1/flags/snapshot
KIOREX_PRODUCT_KEY=ff_kiorly-pharmacy_dev
KIOREX_PRODUCT_SECRET=ff_dev_secret_change_me
FLAGS_POLL_INTERVAL_MS=30000

# Kiorex partner integration (INTEGRATION.md "Vertical partners"). mock = verify locally (default); real = POST to Kiorex.
# Per-tenant URL + secrets live in IntegrationClient (seeded dev registration); these are single-tenant fallbacks.
KIOREX_MODE=mock
KIOREX_BASE_URL=http://localhost:4000

# Consent registry (patient/customer consent capture, e-Rx token introspection, revoke webhook /api/v1/webhooks/providers/consent)
CONSENT_MODE=mock
# CONSENT_API_URL=https://<consent-registry-base-url>
# CONSENT_API_KEY=<secret>
# CONSENT_WEBHOOK_SECRET=<secret>
# AI gateway (OpenAI-compatible /chat/completions). PHI is redacted before any call; output is labelled AI-generated.
AI_MODE=mock
# AI_API_URL=https://<openai-eu-or-compatible-base-url>
# AI_API_KEY=<secret>
# AI_MODEL=<model name>
# AI_MAX_INPUT_TOKENS=2000  AI_MAX_OUTPUT_TOKENS=500  AI_DAILY_TOKEN_BUDGET=100000  AI_COST_PER_1K_TOKENS_USD=<optional>
# Object storage (Rx scans, attachments, exports): mock = local disk under STORAGE_DIR; real = HTTP PUT/GET {url}/{key}. Downloads are signed, expiring URLs only.
STORAGE_MODE=mock
# STORAGE_DIR=.data
# STORAGE_API_URL=https://<object-gateway-base-url>
# STORAGE_API_KEY=<secret>
# STORAGE_SIGNING_SECRET=<optional; defaults to a key derived from STORAGE_API_KEY>
# STORAGE_MAX_BYTES=5242880  STORAGE_URL_TTL_SEC=300
