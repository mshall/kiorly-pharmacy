{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "build": "prisma generate && nest build",
    "dev": "nest start --watch",
    "dev:kiorex": "KIOREX_MODE=real FLAGS_POLL_ENABLED=true FLAGS_POLL_INTERVAL_MS=1500 OUTBOX_POLL_INTERVAL_MS=1000 nest start --watch",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "NODE_ENV=test node --import tsx --test \"src/**/*.node.test.ts\"",
    "test:e2e": "node scripts/run-e2e.mjs",
    "seed": "DEMO_SEED_ALLOWED=true node --require @swc-node/register prisma/seed.ts",
    "seed:demo": "DEMO_SEED_ALLOWED=true node --require @swc-node/register prisma/demo/seed-demo.ts",
    "seed:suite": "DEMO_SEED_ALLOWED=true node --require @swc-node/register prisma/demo/seed-suite.ts",
    "seed:mobile": "DEMO_SEED_ALLOWED=true node --require @swc-node/register prisma/demo/seed-mobile.ts",
    "org:create": "node --require @swc-node/register src/seed/onboard-org.ts",
    "org:create:dist": "node dist/seed/onboard-org.js",
    "demo-data:remove": "node --require @swc-node/register src/seed/demo-data-remove.ts",
    "demo-data:remove:dist": "node dist/seed/demo-data-remove.js",
    "seed:all": "npm run seed && npm run seed:demo && npm run seed:suite && npm run seed:mobile",
    "openapi:export": "node --require @swc-node/register scripts/export-openapi.ts",
    "start:swc": "node --require @swc-node/register src/main.ts",
    "build:seed": "tsc -p tsconfig.seed.json",
    "seed:dist": "node dist-seed/prisma/seed.js",
    "seed:demo:dist": "node dist-seed/prisma/demo/seed-demo.js",
    "seed:suite:dist": "node dist-seed/prisma/demo/seed-suite.js",
    "seed:mobile:dist": "node dist-seed/prisma/demo/seed-mobile.js"
  },
  "dependencies": {
    "@kiorex/contracts": "file:../../vendor/kiorex-contracts-1.13.2.tgz",
    "@kiorly/pharmacy-shared": "*",
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/platform-express": "^12.5.1",
    "@nestjs/swagger": "^12.1.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.10",
    "jose": "^6.2.18",
    "pdfkit": "^0.21.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.16",
    "@nestjs/testing": "^12.5.1",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "fast-check": "^4.10.3",
    "prisma": "^7.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
