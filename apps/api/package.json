{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "build": "prisma generate && nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "NODE_ENV=test node --import tsx --test \"src/**/*.node.test.ts\"",
    "test:e2e": "node scripts/run-e2e.mjs",
    "seed": "node --require @swc-node/register prisma/seed.ts",
    "openapi:export": "node --require @swc-node/register scripts/export-openapi.ts",
    "start:swc": "node --require @swc-node/register src/main.ts"
  },
  "dependencies": {
    "@kiorex/contracts": "file:../../../kiorex-contracts/dist-pack/kiorex-contracts-1.0.0.tgz",
    "@kiorly/pharmacy-shared": "*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/client": "^6.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "jose": "^5.9.6",
    "pdfkit": "^0.20.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.22",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.17.7",
    "@types/supertest": "^7.2.1",
    "fast-check": "^3.23.2",
    "prisma": "^6.1.0",
    "supertest": "^7.3.2",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2"
  }
}
