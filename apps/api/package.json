{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "build": "prisma generate && nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "NODE_ENV=test node --import tsx --test \"src/**/*.node.test.ts\"",
    "test:e2e": "NODE_ENV=test node --import tsx --test --test-concurrency=1 \"test/**/*.e2e.test.ts\""
  },
  "dependencies": {
    "@kiorly/pharmacy-shared": "*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/client": "^6.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2"
  }
}
